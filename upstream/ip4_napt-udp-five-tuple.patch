+  struct ip_napt_entry *t;
+#if LWIP_UDP
+  if (proto == IP_PROTO_UDP) {
+    t = ip_napt_find_udp_outbound(src, sport, dest, dport);
+  } else
+#endif /* LWIP_UDP */
+  {
+    t = ip_napt_find(proto, src, sport, 0, 0);
+  }
